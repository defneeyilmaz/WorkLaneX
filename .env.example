# Copy to .env for local overrides (optional; docker compose uses defaults below)
# cp .env.example .env

# PostgreSQL — used by docker/docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=worklanex
POSTGRES_PORT=5432

# ASP.NET Core — override connection in appsettings.Development.json or User Secrets
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=worklanex;Username=postgres;Password=postgres

# JWT (development only — change before production)
Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
