# Copy to .env for local overrides (optional; docker compose uses defaults below)
# cp .env.example .env

# PostgreSQL — used by docker/docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=worklanex
POSTGRES_PORT=5433

# ASP.NET Core — Port 5433 avoids conflict with a local PostgreSQL on 5432 (common on macOS)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=worklanex;Username=postgres;Password=postgres

# JWT (development only — change before production)
Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# OpenAI (optional — leave empty to use mock breakdown in development)
OpenAi__ApiKey=
OpenAi__Model=gpt-4o-mini

# Production API deploy (Railway / Render / Docker)
# ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=http://+:8080
# PORT=8080
# Cors__AllowedOrigins__0=https://your-frontend.vercel.app
